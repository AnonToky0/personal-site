---
import Layout from '../../layouts/Layout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import { getCollection } from 'astro:content';
import { groupNotes, noteUrl } from '../../lib/notes';
import '../../styles/notes.css';
const notes = await getCollection('notes');
const groups = groupNotes(notes);
const recent = [...notes].sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id)).slice(0, 5);
---
<Layout title="Notes · 学习与记录" description="按主题整理的技术笔记、学习路线与实践记录。" notes>
  <div class="notes-shell notes-home">
    <NotesSidebar notes={notes} />
    <main id="main-content" class="notes-main">
      <header class="notes-home-heading">
        <p class="notes-eyebrow">一点一点，积累成册</p>
        <h1>学习，也留下痕迹。</h1>
        <p class="notes-intro">把遇到的问题、弄懂的原理和动手的过程，<br class="desktop-break" />整理在这里，方便下一次回看。</p>
        <p class="collection-count">{groups.length} 个主题<span>·</span>{notes.length} 篇笔记</p>
      </header>
      <section aria-labelledby="topics-title">
        <div class="section-heading"><h2 id="topics-title">从一个主题开始</h2><span>TOPICS</span></div>
        <div class="topic-cards">{groups.map((group, index) => (
          <a class="topic-card" href={noteUrl(group.notes[0].id)}>
            <div class="topic-card-meta"><span>0{index + 1}</span><span>{group.notes.length} 篇笔记</span></div>
            <h3>{group.title}</h3><p>{group.description}</p>
            <span class="topic-card-action">{group.id === 'computer-net' ? '查看学习路线' : '开始阅读'} <span aria-hidden="true">↗</span></span>
          </a>
        ))}</div>
      </section>
      <section class="recent-notes" aria-labelledby="recent-title">
        <div class="section-heading"><h2 id="recent-title">最近记录</h2><span>RECENT NOTES</span></div>
        <ul>{recent.map(note => <li><a href={noteUrl(note.id)}><span>{note.data.title}</span><time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0, 10)}</time></a></li>)}</ul>
      </section>
      {notes.length === 0 && <p>第一篇笔记，正在路上。</p>}
    </main>
    <aside class="notes-home-aside"><p class="sidebar-caption">关于这些笔记</p><p>沿着主题慢慢读，<br />也可以带着问题来查。</p><p>笔记会随着学习持续补充。</p><span class="aside-rule"></span><p class="small-label">保持好奇，慢慢积累。</p></aside>
  </div>
</Layout>
