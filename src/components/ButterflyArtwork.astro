---
import { Image } from 'astro:assets';
import bluebottle from '../assets/fox/bluebottle-v1.png';
interface Props { decorative?: boolean; motion?: 'companion' | 'preview'; }
const { decorative = false, motion } = Astro.props;
const description = '绘本风格青凤蝶，深色翅面上有青绿色带状斑纹';
---
{motion ? (
	<butterfly-flight data-preview={String(motion === 'preview')} role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : description} aria-hidden={decorative ? 'true' : undefined}>
		<span class="flight-body">
			{['left', 'right', 'body'].map(part => (
				<span class:list={['layer', part]}><Image src={bluebottle} alt="" width={384} format="webp" quality={88} loading="eager" draggable="false" /></span>
			))}
		</span>
	</butterfly-flight>
) : <Image src={bluebottle} alt={decorative ? '' : description} width={384} format="webp" quality={88} loading="eager" draggable="false" />}

<script>
	import '../scripts/butterfly-flight';
</script>
<style>
	img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; }
	butterfly-flight, .flight-body { display: block; position: relative; width: 100%; height: 100%; }
	.flight-body { transform: translateY(var(--butterfly-float, 0px)); }
	.layer { position: absolute; inset: 0; display: block; transform-origin: 49% 47%; }
	/* The cuts follow the transparent gap around the antennae and the body.
	   All three layers share the original image, and the body covers the hinges. */
	.left {
		clip-path: polygon(0 0, 33% 0, 33% 14%, 45.5% 36%, 45.5% 41%, 46% 47%, 46.8% 54%, 46.8% 72%, 49% 78%, 49% 100%, 0 100%);
		transform: rotateY(var(--butterfly-left, 0deg));
	}
	.right {
		clip-path: polygon(64.8% 0, 100% 0, 100% 100%, 49% 100%, 49% 78%, 51.2% 72%, 51.2% 54%, 52% 47%, 52.5% 41%, 52.5% 36%, 64.8% 14%);
		transform: rotateY(var(--butterfly-right, 0deg));
	}
	.body {
		clip-path: polygon(33% 0, 64.8% 0, 64.8% 14%, 52.5% 36%, 52.5% 41%, 52% 47%, 51.2% 54%, 51.2% 72%, 49% 78%, 46.8% 72%, 46.8% 54%, 46% 47%, 45.5% 41%, 45.5% 36%, 33% 14%);
	}
	@media (prefers-reduced-motion: reduce) {
		.flight-body, .layer { transform: none !important; }
	}
</style>
