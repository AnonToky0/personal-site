---
import { Image } from 'astro:assets';
import bluebottle from '../assets/fox/bluebottle-v1.png';
interface Props { decorative?: boolean; }
const { decorative = false } = Astro.props;
---
<Image src={bluebottle} alt={decorative ? '' : '绘本风格青凤蝶，深色翅面上有青绿色带状斑纹'} width={384} format="webp" quality={88} loading="eager" draggable="false" />
<style>
	img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; }
</style>
