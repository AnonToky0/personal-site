---
import Header from '../components/Header.astro';
import FoxPet from '../components/FoxPet.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Astro Basics', description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<Header />
		
		<slot />
		<FoxPet />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	html { min-height: 100%; background: #f7f5f0; color: #342f29; font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; }
	body { margin: 0 auto; width: min(1100px, calc(100% - 40px)); min-height: 100dvh; padding-bottom: 220px; }
</style>
